# secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# node
node_modules/

# os
.DS_Store

# bisect: runs, data (fixtures/manifests are tracked), vendored deps, builds
runs/
# `data/*` (not `data/`) is deliberate: a directory-only ignore prunes git's
# traversal into it entirely, so a later `!data/fixtures/` can't resurrect
# anything underneath -- see `git help gitignore`, "It is not possible to
# re-include a file if a parent directory of that file is excluded."
data/*
!data/fixtures/
!data/manifest*
vendor/
web/node_modules/
dist/
.coverage
htmlcov/

# web: test and e2e artefacts (the release build in agent_bisect/server/static/ is committed deliberately, never by default)
web/playwright-report/
web/test-results/
web/coverage/

# built dashboard: committed at the end of P6 (docs/gates/P6.md) so
# `uv tool install .` needs no Node. Rebuild with `make web` before a release.

# `runs/` above is any directory of that name; the dashboard feature folder is source.
!web/src/features/runs/
